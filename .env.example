NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Proxy hops trusted for request.ip. Use 2 for Render's current public web path.
# Leave empty to use 0 locally and 2 in production.
TRUST_PROXY_HOPS=

# Supabase Postgres connection string from Project Settings > Database > Connect.
# Use session-mode pooler if your local network cannot reach the direct IPv6 endpoint.
DATABASE_URL=

# Supabase Storage (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=chat-media
SUPABASE_DB_CA_FILE=certs/supabase-ca.crt
SUPABASE_SECRET_KEY=

# Upstash Redis REST API credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Authentication secrets - use long, unique random values outside local development.
JWT_ACCESS_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email provider (to be selected/configured)
EMAIL_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
